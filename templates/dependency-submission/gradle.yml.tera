{# Ward template: .github/workflows/dependency-submission.yml for Gradle projects #}
name: Dependency Submission

on:
  push:
    branches:
      - {{ default_branch | default(value="main") }}
  workflow_dispatch:

permissions:
  contents: write
  id-token: write

env:
  JAVA_VERSION: {{ java_version | default(value="21") }}

jobs:
  dependency-submission:
    name: Submit dependency graph
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: exampleorg/gap/actions/checkout@v6

      - name: Set up JDK
        uses: exampleorg/gap/actions/setup-java@v5
        with:
          distribution: temurin
          java-version: ${{ "{{" }} env.JAVA_VERSION {{ "}}" }}

      - name: Set up JFrog
        id: jfrogsetup
        uses: exampleorg/sys-ci-jman/setup-jfrog-cli@v0.7.3

      - name: Submit dependency graph
        uses: exampleorg/gap/gradle/actions/dependency-submission@v5
        env:
          JFROG_USERNAME: '${{ "{{" }} steps.jfrogsetup.outputs.oidc-user {{ "}}" }}'
          JFROG_PASSWORD: '${{ "{{" }} steps.jfrogsetup.outputs.oidc-token {{ "}}" }}'
