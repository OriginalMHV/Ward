{# Ward template: .github/dependabot.yml for Gradle projects #}
version: 2
registries:
  gradle-artifactory:
    type: maven-repository
    url: {{ registry_url | default(value="https://example.jfrog.io/artifactory/maven") }}
{% if jfrog_oidc_provider %}
    jfrog-oidc-provider-name: '{{ jfrog_oidc_provider }}'
    audience: '{{ jfrog_oidc_provider }}'
{% endif %}
    replaces-base: true
updates:
  - package-ecosystem: gradle
    directory: /
    schedule:
      interval: weekly
    groups:
      minor-and-patch:
        update-types: [ "minor", "patch" ]
      major:
        update-types: [ "major" ]
    registries:
      - gradle-artifactory
